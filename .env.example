# All optional. Defaults shown. Only judge:talk and judge:live read .env; `npm run judge` needs none of this.
# Those scripts set the scenario, controller, talk, pilots, radio, data dir and cap themselves, and that wins over this file.
PORT=8787
# judge-demo | guided-demo | sandbox (real Pearson layout) | guided-demo-schematic | sandbox-schematic (small test airport)
TOWERAI_SCENARIO=judge-demo
# baseline = rule-based demo, elevenlabs = hosted LLM decisions, none = external controller.
TOWERAI_CONTROLLER=baseline
# judge:talk and judge:live need a key, then one run of packages/server/src/agents/setup.ts (free).
# An agent id overrides the tower's in packages/server/data/agents.json.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
# simulated = transmissions time themselves. external = wait for the voice layer to report tx_complete / tx_failed.
TOWERAI_RADIO_CONTROLLER=simulated
TOWERAI_RADIO_PILOTS=simulated
TOWERAI_SPEED=1
# on = live speech in the cockpit and world (spends). judge:talk sets it.
TOWERAI_TALK=off
# on = some pilot turns are LLM (spends). judge:live sets it.
TOWERAI_AI_PILOTS=off
# The model setup.ts gives the agents. Unset keeps the saved one, or gpt-6-luna.
# TOWERAI_LLM=gpt-6-luna
# Where run logs go, relative to packages/server under npm start and npm run dev. "off" disables recording.
TOWERAI_DATA_DIR=data/runs
# Required on every POST when set. The bundled web app does not send it: use it only for API or webhook
# access, and leave it empty for the demo. Set this before exposing the server beyond localhost (e.g. through a tunnel for ElevenLabs webhooks).
TOWERAI_SECRET=
# One exact origin. Empty means same origin only.
TOWERAI_CORS_ORIGIN=
# judge:talk and judge:live use 9500, the most the code allows. To lower that, set it in the shell, which this file cannot override:
#   TOWERAI_CREDIT_CAP=500 npm run judge:talk
TOWERAI_CREDIT_CAP=3500
