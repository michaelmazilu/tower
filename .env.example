# All optional. Defaults shown. Only `npm run judge:live` reads .env; the demo (`npm run judge`) needs none of this.
PORT=8787
# judge-demo | guided-demo | sandbox (real Pearson layout) | guided-demo-schematic | sandbox-schematic (small test airport)
TOWERAI_SCENARIO=judge-demo
# baseline = rule-based demo, elevenlabs = hosted LLM decisions, none = external controller.
TOWERAI_CONTROLLER=baseline
# The key is all judge:live needs. An agent id overrides the one in packages/server/data/agents.json.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
# simulated = transmissions time themselves. external = wait for the voice layer to report tx_complete / tx_failed.
TOWERAI_RADIO_CONTROLLER=simulated
TOWERAI_RADIO_PILOTS=simulated
TOWERAI_SPEED=1
# Where run logs go. "off" disables recording.
TOWERAI_DATA_DIR=data/runs
# Required on every POST when set. Set this before exposing the server beyond localhost (e.g. through a tunnel for ElevenLabs webhooks).
TOWERAI_SECRET=
# One exact origin. Empty means same origin only.
TOWERAI_CORS_ORIGIN=
# judge:live sets 5000, the most the code allows.
TOWERAI_CREDIT_CAP=3500
